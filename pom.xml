<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.github</groupId>
    <artifactId>im-cluster</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>im-cluster</name>
    <description>IM 服务：按职责拆分为长连接服务(im-gateway)与 IM 业务服务(im-server)</description>

    <properties>
        <java.version>25</java.version>
        <!-- MyBatis-Plus 不在 Spring Boot BOM 里，版本必须在这里钉住：
             3.5.16 的 spring-boot4-starter 才支持 Spring Boot 4 / Spring Framework 7，
             误用 spring-boot3-starter 会在启动时因 Spring 6 的 API 缺失而失败。 -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
    </properties>

    <!--
      模块划分（与「长连接服务 / IM 服务」的职责边界一一对应）：

        im-proto    两服务共享的契约层：protobuf/gRPC 定义 + 端口接口 + 消息信封。
                    这是唯一的跨服务共享代码，禁止放业务实现。
        im-gateway  长连接服务（库）：连接维护、心跳保活、消息收发通道、连接状态管理。
                    自身不含任何消息持久化与业务逻辑。
        im-server   IM 服务（库）：消息存储、会话管理、消息路由、业务逻辑。
                    自身不感知 WebSocket / 连接 / 设备通道。
        im-storage-redis 消息存储的 Redis 实现（im.storage=redis，或缺省不配时生效）。
        im-storage-jdbc  消息存储的 MySQL 实现 + DDL（im.storage=jdbc 时生效）。
                    两者都只依赖 im-server 的存储端口 MessageRepository，反向不依赖；
                    im-server 自身不含任何存储实现，部署入口按 im.storage 选一个。
        im-rpc      gRPC 适配层（客户端侧）：RemoteMessageIngress（网关→IM）、
                    RemoteGatewayPushPort（IM→网关）、在线路由只读、channel 复用。
                    只被「部署入口」依赖，业务模块不依赖它（保持业务无传输细节）。

        im-app      单体装配器：同进程装配两个服务，行为与拆分前一致。
                    通过 im.ingress.transport 支持 local / grpc / shadow 三档，
                    shadow 即「同一上行同时走本地与远程，比对结果，只以本地为准」。
        im-gateway-boot 长连接服务独立部署入口：只承载连接，上行全走 gRPC，
                    并自带优雅摘流（session.migrate）与按连接数的 HPA 指标。
        im-server-boot  IM 服务独立部署入口。
        im-benchmark    压测端（可执行 jar）：作为「真实客户端」用大量 WebSocket 长连接
                    压网关的建连 / 心跳 / 上行受理与下行推送，只依赖 Netty + Jackson，
                    刻意不依赖任何业务模块，避免压测机替被测代码背 GC 与类加载的锅。
        im-client       客户端 SDK（库）：App / 桌面端接入用。走 TCP 上行（首帧 connect 认证），
                    负责断线指数退避重连、本地消息表（待发重投 + 已收去重 + 水位恢复）、
                    心跳应答与 msg.recv / msg.read 上报。只依赖 Jackson，
                    既不含 Netty 也不含 Spring：SDK 的依赖会原样变成宿主的依赖。

      依赖方向（编译期单向，禁止反向）：
        im-app           -> im-gateway / im-server / im-rpc -> im-proto
        im-gateway-boot  -> im-gateway / im-rpc             -> im-proto
        im-server-boot   -> im-server  / im-rpc             -> im-proto
        im-storage-redis -> im-server                       -> im-proto
        im-storage-jdbc  -> im-server                       -> im-proto
        im-gateway 与 im-server 互不依赖；业务模块不依赖 im-rpc；两个 storage 模块之间互不依赖。
    -->
    <modules>
        <module>im-proto</module>
        <module>im-rpc</module>
        <module>im-gateway</module>
        <module>im-server</module>
        <module>im-storage-redis</module>
        <module>im-storage-jdbc</module>
        <module>im-app</module>
        <module>im-gateway-boot</module>
        <module>im-server-boot</module>
        <module>im-benchmark</module>
        <module>im-client</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-proto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-rpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-storage-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-storage-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github</groupId>
                <artifactId>im-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
