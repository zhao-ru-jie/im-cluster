<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github</groupId>
        <artifactId>im-cluster</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-gateway</artifactId>
    <name>im-gateway</name>
    <description>长连接服务：连接维护、心跳保活、消息收发通道、连接状态管理</description>

    <dependencies>
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>im-proto</artifactId>
        </dependency>

        <!-- HTTP 短请求（/admin/drain、/actuator/*）：容器用 Tomcat，与长连接完全分离。
             之所以要显式声明：原先它是被 spring-boot-starter-websocket 传递引入的。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 长连接接入：Netty 直连（WebSocket 与原生 TCP 共用一套 ServerBootstrap）。
             刻意不再引入 spring-boot-starter-websocket：连接由 Netty event loop 承载，
             Tomcat 只保留给 /admin 与 /actuator 这些短请求。 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- 在线路由表 / 租约（im:gateway:user:{userId}） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 下行帧 JSON 编解码 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- DownstreamPush gRPC 服务端 + 跨网关实例的 gRPC 客户端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-server</artifactId>
        </dependency>

        <!-- 测试：鉴权档位与 token 校验不依赖网络，纯单测即可覆盖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 本实例也暴露 grpc.health.v1.Health（同上，Boot 自动配置的生效前提）。
             网关是服务端：IM 服务推下行时据此避开正在启动/摘流的网关实例。 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
        </dependency>
        <!-- Nacos-Client：网关实例地址注册与动态发现（不做 per-user 路由） -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>3.2.4</version>
        </dependency>

        <!-- 扩容指标：连接数 HPA 的主指标（CPU 在空闲连接场景下不可用），暴露 /actuator/prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>
</project>
