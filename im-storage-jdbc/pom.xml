<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github</groupId>
        <artifactId>im-cluster</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-storage-jdbc</artifactId>
    <name>im-storage-jdbc</name>
    <description>MessageRepository / GroupMemberRepository 的 MySQL 实现（MyBatis-Plus，im.storage=jdbc 时生效）</description>

    <dependencies>
        <!-- 只需要 IM 服务的存储端口（MessageRepository / StoredMessage / GroupMemberRepository） -->
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>im-server</artifactId>
        </dependency>

        <!--
          持久层用 MyBatis-Plus：
            - 单表 CRUD / 条件查询（recent、since、maxSeq）走 BaseMapper + LambdaQueryWrapper，
              不用手写 SQL，字段改名时编译期就会报错；
            - 只有 MySQL 方言才有的语义（如 INSERT IGNORE 的幂等加成员）才落到 Mapper 上的注解 SQL。

          注意必须用 spring-boot4-starter：spring-boot3-starter 依赖 Spring 6，
          在 Spring Framework 7 上会因 API 缺失启动失败。

          它会把 spring-boot-starter-jdbc 一并带进来（spring-jdbc + HikariCP 我们本来就在用），
          但 MybatisPlusAutoConfiguration 是 @ConditionalOnSingleCandidate(DataSource.class)：
          im.storage=redis 时不创建 DataSource，MyBatis 相关 Bean 一个都不会生成。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- group commit 的合并/失败语义可以用 mock 的 SqlSessionFactory 完整覆盖，不需要真库 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
