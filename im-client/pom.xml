<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github</groupId>
        <artifactId>im-cluster</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-client</artifactId>
    <name>im-client</name>
    <description>客户端 SDK：长连接维持、断线指数退避重连、本地消息表（待发重投 / 已收去重 / 水位恢复）</description>

    <!--
      依赖边界（与 im-benchmark 同一条理由，但更严格）：
        只依赖 Jackson（tools.jackson，与网关同代，避免字段名/数字格式理解分叉），
        不依赖 Netty、不依赖 Spring、不依赖任何服务端模块。

      为什么不用 Netty：SDK 只有一条连接（一个用户 + 一个设备），
      Netty 带来的是 event loop 生命周期、ByteBuf 引用计数、handler 顺序这三类复杂度，
      而它省下的「线程开销」在单连接场景里等于零。用 java.net.Socket + 一条虚拟线程读循环，
      代码量小一个量级，Android / 桌面 / 服务端都能直接跑。

      为什么不用 slf4j：SDK 不该替宿主应用决定日志门面。内部用 JDK 的 System.Logger
      （宿主没有桥接时静默降级），对外用 ImClientListener 回调。

      帧格式在模块内独立实现一份，不复用网关的 ClientFrames：
      客户端只需要「构造上行帧 + 解析下行帧」，复用服务端编码器会把服务端语义带进来，
      而一旦客户端能调用服务端的编码方法，就没人会再去保证 wire 格式是对的了。
    -->
    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          仅测试用：验证 JdbcLocalMessageTable 真的能在真实数据库上跑。
          SDK 自己<b>不</b>打包任何 JDBC 驱动——驱动是宿主的部署决定
          （Android 用系统 SQLite、桌面用 xerial、服务端可能直接复用连接池），
          这里引入只是为了给「宿主给 DataSource」这条路做一次真实回归。
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
