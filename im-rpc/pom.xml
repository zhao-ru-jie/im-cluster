<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github</groupId>
        <artifactId>im-cluster</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-rpc</artifactId>
    <name>im-rpc</name>
    <description>gRPC 适配层（客户端侧）：远程上行、远程下行推送、在线路由只读，供各部署入口装配</description>

    <dependencies>
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>im-proto</artifactId>
        </dependency>

        <!-- gRPC 客户端（Netty channel） -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
        </dependency>
        <!-- 下行推送需要读在线路由表（只读，不写） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- TLS 客户端证书加载（ClassPathResource / FileSystemResource） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>

        <!-- 测试：健康检查的端到端验证需要起真实的 gRPC 服务端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 服务端的 grpc.health.v1.Health 实现（与生产同款，Boot 自动配置检查的也是这个类） -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
